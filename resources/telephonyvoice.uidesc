    <view class="CTextLabel" origin="500, 389" size="250, 19" title="Output gain (dB)" font="Label" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CSlider" custom-view-name="TelephonySlider" origin="500, 415" size="282, 20" control-tag="Gain" min-value="0" max-value="1" orientation="horizontal" reverse-orientation="false" mode="free click" draw-back="true" draw-back-color="Control" draw-frame="true" draw-frame-color="Border" draw-value="true" draw-value-color="Teal" transparent="false" mouse-enabled="true" wants-focus="true" wheel-inc-value="0.01" zoom-factor="10" tooltip="Output gain, -60 to +24 dB. Hold Shift for fine adjustment." />
