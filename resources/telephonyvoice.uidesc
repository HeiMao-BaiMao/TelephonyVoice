      <view class="COptionMenu" origin="0, 21" size="200, 30" control-tag="EvsBandwidth" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Requested EVS maximum bandwidth. The codec caps it by sample rate. SC-VBR uses NB/WB; other codec-safe bitrate and bandwidth constraints also apply." />
      <view class="CTextLabel" origin="175, 23" size="18, 26" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    </view>
    <view class="CViewContainer" origin="710, 584" size="186, 52" transparent="true" telephony-group="evs-options" mouse-enabled="true">
      <view class="CTextLabel" origin="0, 0" size="186, 18" title="SID interval (frames) / 0 = auto" font="Small" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CTextEdit" origin="0, 21" size="66, 30" control-tag="EvsSid" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center" text-inset="5, 0" transparent="false" mouse-enabled="true" wants-focus="true" immediate-text-change="false" style-doubleclick="false" tooltip="DTX SID interval: 0 is variable; 3–100 are fixed 20 ms frames. Values 1 and 2 are treated as variable (0)." />
      <view class="CTextButton" origin="78, 21" size="108, 30" control-tag="EvsScVbr" title="Force VBR: Off" telephony-name="sc-vbr" font="Label" text-color="Text" text-color-highlighted="Dark Text" gradient="Button" gradient-highlighted="Button Active" frame-color="Border" frame-color-highlighted="Teal" frame-width="1" round-radius="5" kick-style="false" text-alignment="center" mouse-enabled="true" wants-focus="true" tooltip="Force EVS SC-VBR regardless of the selected bitrate (nominal 5.9 kbps, NB/WB). Off restores the selected rate, except that a 5.9 kbps selection always uses SC-VBR." />
    </view>
    <view class="CViewContainer" origin="266, 525" size="422, 52" transparent="true" telephony-group="distribution-note" mouse-enabled="true">
      <view class="CTextLabel" origin="0, 0" size="422, 24" title="GSM FR needs no extra settings." font="Body" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
