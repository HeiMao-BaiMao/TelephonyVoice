<?xml version='1.0' encoding='utf-8'?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Background" rgba="#11191fff" />
    <color name="Panel" rgba="#1b2730ff" />
    <color name="Panel Deep" rgba="#152129ff" />
    <color name="Control" rgba="#263640ff" />
    <color name="Border" rgba="#42535eff" />
    <color name="Text" rgba="#eff5f6ff" />
    <color name="Muted" rgba="#b2c1caff" />
    <color name="Teal" rgba="#64d7c5ff" />
    <color name="Amber" rgba="#efbd75ff" />
    <color name="Dark Text" rgba="#142229ff" />
    <color name="Focus" rgba="#a0efe1ff" />
  </colors>
  <fonts>
    <font name="Brand" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="26" bold="true" />
    <font name="Heading" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="16" bold="true" />
    <font name="Body" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="13" bold="false" />
    <font name="Label" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="11" bold="false" />
    <font name="Small" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="10" bold="false" />
    <font name="Endpoint" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="16" bold="true" />
    <font name="Arrow" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="24" bold="false" />
  </fonts>
  <gradients>
    <gradient name="Button">
      <color-stop rgba="#263640ff" start="0" />
      <color-stop rgba="#263640ff" start="1" />
    </gradient>
    <gradient name="Button Active">
      <color-stop rgba="#64d7c5ff" start="0" />
      <color-stop rgba="#64d7c5ff" start="1" />
    </gradient>
  </gradients>
  <control-tags>
    <control-tag name="Input" tag="100" />
    <control-tag name="DryWet" tag="101" />
    <control-tag name="Gain" tag="102" />
    <control-tag name="Artifacts" tag="103" />
    <control-tag name="ArtifactAmount" tag="104" />
    <control-tag name="Bypass" tag="105" />
    <control-tag name="PacketLoss" tag="106" />
    <control-tag name="Degradation" tag="107" />
    <control-tag name="Output" tag="108" />
    <control-tag name="EvsRate" tag="109" />
    <control-tag name="EvsBitrate" tag="110" />
    <control-tag name="EvsBandwidth" tag="111" />
    <control-tag name="Segment" tag="112" />
    <control-tag name="AmrWb" tag="113" />
    <control-tag name="AmrNb" tag="115" />
    <control-tag name="G711Law" tag="116" />
    <control-tag name="EvsSid" tag="117" />
    <control-tag name="EvsScVbr" tag="118" />
  </control-tags>
  <template name="view" class="CViewContainer" origin="0, 0" size="940, 680" minSize="940, 680" maxSize="940, 680" background-color="Background" transparent="false" mouse-enabled="true">
    <view class="CTextLabel" origin="24, 24" size="42, 42" title="" back-color="Teal" frame-color="Teal" style-round-rect="true" round-rect-radius="8" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="25, 30" size="40, 30" title="TV" font="Heading" font-color="Dark Text" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="80, 20" size="310, 36" title="TelephonyVoice" font="Brand" font-color="Text" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="81, 56" size="400, 17" title="TELEPHONE PATH EMULATOR" font="Small" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="504, 34" size="246, 24" title="IN → EXCHANGE → OUT" font="Label" font-color="Teal" font-antialias="true" text-alignment="right" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextButton" origin="776, 28" size="140, 36" control-tag="Bypass" title="BYPASS OFF" telephony-name="bypass" font="Body" text-color="Text" text-color-highlighted="Dark Text" gradient="Button" gradient-highlighted="Button Active" frame-color="Border" frame-color-highlighted="Teal" frame-width="1" round-radius="5" kick-style="false" text-alignment="center" mouse-enabled="true" wants-focus="true" tooltip="Host bypass: latency-compensated dry signal." />
    <view class="CTextLabel" origin="24, 92" size="892, 178" title="" back-color="Panel" frame-color="Panel" style-round-rect="true" round-rect-radius="10" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="44, 108" size="248, 20" title="01 / INPUT" font="Label" font-color="Teal" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="350, 108" size="240, 20" title="02 / EXCHANGE" font="Label" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="648, 108" size="248, 20" title="03 / OUTPUT" font="Label" font-color="Teal" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="COptionMenu" origin="44, 141" size="248, 38" control-tag="Input" font="Endpoint" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Input telephone endpoint. Host automation is supported." />
    <view class="CTextLabel" origin="267, 143" size="18, 34" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="COptionMenu" origin="648, 141" size="248, 38" control-tag="Output" font="Endpoint" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Output telephone endpoint. The two legs may use different codecs." />
    <view class="CTextLabel" origin="871, 143" size="18, 34" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="307, 143" size="38, 34" title="→" font="Arrow" font-color="Amber" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="595, 143" size="38, 34" title="→" font="Arrow" font-color="Amber" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="350, 136" size="240, 49" title="" back-color="Panel Deep" frame-color="Panel Deep" style-round-rect="true" round-rect-radius="6" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="358, 149" size="224, 24" title="交換局 / Exchange" font="Heading" font-color="Text" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="44, 189" size="265, 20" title="G.711 / 8 kHz" font="Body" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="input-codec" />
    <view class="CTextLabel" origin="648, 189" size="248, 20" title="EVS / configurable bandwidth" font="Body" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="output-codec" />
    <view class="CTextLabel" origin="44, 222" size="252, 18" title="DEGRADATION TARGET" font="Small" font-color="Amber" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="input-target" />
    <view class="CTextLabel" origin="648, 222" size="248, 18" title="DEGRADATION TARGET" font="Small" font-color="Amber" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="output-target" />
    <view class="CTextLabel" origin="350, 194" size="240, 18" title="Degraded segment / 劣化区間" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="COptionMenu" origin="350, 218" size="240, 30" control-tag="Segment" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Choose which leg receives packet loss and communication degradation." />
