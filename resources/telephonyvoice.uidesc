    <view class="CSlider" custom-view-name="TelephonySlider" origin="500, 359" size="282, 20" control-tag="DryWet" min-value="0" max-value="1" orientation="horizontal" reverse-orientation="false" mode="free click" draw-back="true" draw-back-color="Control" draw-frame="true" draw-frame-color="Border" draw-value="true" draw-value-color="Teal" transparent="false" mouse-enabled="true" wants-focus="true" wheel-inc-value="0.01" zoom-factor="10" tooltip="Wet mix. 0% is aligned dry, 100% is the telephone route." />
