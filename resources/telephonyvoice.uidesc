    </view>
    <view class="CViewContainer" origin="266, 584" size="200, 52" transparent="true" telephony-group="evs-bitrate" mouse-enabled="true">
      <view class="CTextLabel" origin="0, 0" size="200, 18" title="EVS bitrate" font="Label" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="COptionMenu" origin="0, 21" size="200, 30" control-tag="EvsBitrate" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Requested EVS bitrate. 5.9 kbps inherently uses SC-VBR. Force VBR overrides this selection; switching it off restores the selected rate. NB is capped at 24.4 kbps." />
      <view class="CTextLabel" origin="175, 23" size="18, 26" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    </view>
    <view class="CViewContainer" origin="488, 584" size="200, 52" transparent="true" telephony-group="evs-bandwidth" mouse-enabled="true">
