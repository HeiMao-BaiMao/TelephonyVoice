      <view class="CTextLabel" origin="350, 44" size="240, 49" title="" back-color="Panel Deep" frame-color="Panel Deep" style-round-rect="true" round-rect-radius="6" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
      <view class="CTextLabel" origin="358, 57" size="224, 24" title="交換局 / Exchange" font="Heading" font-color="Text" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CTextLabel" origin="44, 97" size="265, 20" title="G.711 / 8 kHz" font="Body" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="input-codec" />
      <view class="CTextLabel" origin="648, 97" size="248, 20" title="EVS / configurable bandwidth" font="Body" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="output-codec" />
      <view class="CTextLabel" origin="44, 130" size="252, 18" title="DEGRADATION TARGET" font="Small" font-color="Amber" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="input-target" />
      <view class="CTextLabel" origin="648, 130" size="248, 18" title="DEGRADATION TARGET" font="Small" font-color="Amber" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="output-target" />
      <view class="CTextLabel" origin="350, 102" size="240, 18" title="Degraded segment / 劣化区間" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="COptionMenu" origin="350, 126" size="240, 30" control-tag="Segment" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Choose which leg receives packet loss and communication degradation." />
