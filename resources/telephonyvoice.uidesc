    <view class="CTextLabel" origin="480, 286" size="436, 186" title="" back-color="Panel" frame-color="Panel" style-round-rect="true" round-rect-radius="10" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="44, 298" size="270, 24" title="Network character" font="Heading" font-color="Text" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="335, 300" size="105, 20" title="SIMULATED" font="Small" font-color="Amber" font-antialias="true" text-alignment="right" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CViewContainer" origin="44, 333" size="396, 110" transparent="true" telephony-group="network-controls" mouse-enabled="true">
      <view class="CTextLabel" origin="0, 0" size="230, 19" title="Packet loss (%)" font="Label" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CSlider" custom-view-name="TelephonySlider" origin="0, 26" size="282, 20" control-tag="PacketLoss" min-value="0" max-value="1" orientation="horizontal" reverse-orientation="false" mode="free click" draw-back="true" draw-back-color="Control" draw-frame="true" draw-frame-color="Border" draw-value="true" draw-value-color="Amber" transparent="false" mouse-enabled="true" wants-focus="true" wheel-inc-value="0.01" zoom-factor="10" tooltip="Configured frame/packet loss probability, from 0 to 30 percent. Not a measured loss meter." />
      <view class="CTextEdit" origin="300, 16" size="96, 34" control-tag="PacketLoss" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center" text-inset="5, 0" transparent="false" mouse-enabled="true" wants-focus="true" immediate-text-change="false" style-doubleclick="false" tooltip="Packet loss in percent, 0–30." />
      <view class="CTextLabel" origin="0, 56" size="292, 19" title="Communication degradation (%)" font="Label" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CSlider" custom-view-name="TelephonySlider" origin="0, 82" size="282, 20" control-tag="Degradation" min-value="0" max-value="1" orientation="horizontal" reverse-orientation="false" mode="free click" draw-back="true" draw-back-color="Control" draw-frame="true" draw-frame-color="Border" draw-value="true" draw-value-color="Amber" transparent="false" mouse-enabled="true" wants-focus="true" wheel-inc-value="0.01" zoom-factor="10" tooltip="Couples bandwidth narrowing and burst loss; 0 to 100 percent." />
      <view class="CTextEdit" origin="300, 72" size="96, 34" control-tag="Degradation" font="Body" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center" text-inset="5, 0" transparent="false" mouse-enabled="true" wants-focus="true" immediate-text-change="false" style-doubleclick="false" tooltip="Communication degradation in percent, 0–100." />
    </view>
    <view class="CTextLabel" origin="44, 448" size="396, 17" title="Configured loss per selected leg. This is not a live meter." font="Small" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="network-note" />
    <view class="CTextLabel" origin="500, 298" size="240, 24" title="Mix &amp; output" font="Heading" font-color="Text" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
