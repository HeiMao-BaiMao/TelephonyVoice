<?xml version='1.0' encoding='utf-8'?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Background" rgba="#11191fff" />
    <color name="Panel" rgba="#1b2730ff" />
    <color name="Panel Deep" rgba="#152129ff" />
    <color name="Control" rgba="#263640ff" />
    <color name="Border" rgba="#42535eff" />
    <color name="Text" rgba="#eff5f6ff" />
    <color name="Muted" rgba="#b2c1caff" />
    <color name="Teal" rgba="#64d7c5ff" />
    <color name="Amber" rgba="#efbd75ff" />
    <color name="Dark Text" rgba="#142229ff" />
    <color name="Focus" rgba="#a0efe1ff" />
  </colors>
  <fonts>
    <font name="Brand" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="26" bold="true" />
    <font name="Heading" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="16" bold="true" />
    <font name="Body" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="13" bold="false" />
    <font name="Label" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="11" bold="false" />
    <font name="Small" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="10" bold="false" />
    <font name="Endpoint" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="16" bold="true" />
    <font name="Arrow" font-name="Segoe UI" alternative-font-names="Helvetica Neue,Arial,Noto Sans,DejaVu Sans" size="24" bold="false" />
  </fonts>
  <gradients>
    <gradient name="Button">
      <color-stop rgba="#263640ff" start="0" />
      <color-stop rgba="#263640ff" start="1" />
    </gradient>
    <gradient name="Button Active">
      <color-stop rgba="#64d7c5ff" start="0" />
      <color-stop rgba="#64d7c5ff" start="1" />
    </gradient>
  </gradients>
