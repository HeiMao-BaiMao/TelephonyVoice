  <template name="view" class="CViewContainer" origin="0, 0" size="940, 680" minSize="940, 680" maxSize="940, 680" background-color="Background" transparent="false" mouse-enabled="true">
    <view class="CTextLabel" origin="24, 24" size="42, 42" title="" back-color="Teal" frame-color="Teal" style-round-rect="true" round-rect-radius="8" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="25, 30" size="40, 30" title="TV" font="Heading" font-color="Dark Text" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="80, 20" size="310, 36" title="TelephonyVoice" font="Brand" font-color="Text" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextLabel" origin="81, 56" size="400, 17" title="TELEPHONE PATH EMULATOR" font="Small" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CTextButton" origin="776, 28" size="140, 36" control-tag="Bypass" title="BYPASS OFF" telephony-name="bypass" font="Body" text-color="Text" text-color-highlighted="Dark Text" gradient="Button" gradient-highlighted="Button Active" frame-color="Border" frame-color-highlighted="Teal" frame-width="1" round-radius="5" kick-style="false" text-alignment="center" mouse-enabled="true" wants-focus="true" tooltip="Host bypass: latency-compensated dry signal." />
    <view class="CTextLabel" origin="24, 656" size="360, 16" title="PERSONAL BUILD / contains reference codecs" font="Small" font-color="Muted" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" telephony-name="build-note" />
    <view class="CTextLabel" origin="434, 656" size="482, 16" title="Tab: focus   •   Arrows: adjust   •   Right-click: zoom" font="Small" font-color="Muted" font-antialias="true" text-alignment="right" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
    <view class="CViewContainer" origin="0, 92" size="940, 552" transparent="true" telephony-group="basic-page" mouse-enabled="true">
      <view class="CTextLabel" origin="24, 0" size="892, 178" title="" back-color="Panel" frame-color="Panel" style-round-rect="true" round-rect-radius="10" style-no-frame="false" transparent="false" mouse-enabled="false" wants-focus="false" />
      <view class="CTextLabel" origin="44, 16" size="248, 20" title="01 / INPUT" font="Label" font-color="Teal" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CTextLabel" origin="350, 16" size="240, 20" title="02 / EXCHANGE" font="Label" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="CTextLabel" origin="648, 16" size="248, 20" title="03 / OUTPUT" font="Label" font-color="Teal" font-antialias="true" text-alignment="left" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="COptionMenu" origin="44, 49" size="248, 38" control-tag="Input" font="Endpoint" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Input telephone endpoint. Host automation is supported." />
      <view class="CTextLabel" origin="267, 51" size="18, 34" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
      <view class="COptionMenu" origin="648, 49" size="248, 38" control-tag="Output" font="Endpoint" font-color="Text" back-color="Control" frame-color="Border" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="left" text-inset="10, 0" transparent="false" mouse-enabled="true" wants-focus="true" menu-check-style="true" tooltip="Output telephone endpoint. The two legs may use different codecs." />
      <view class="CTextLabel" origin="871, 51" size="18, 34" title="▼" font="Small" font-color="Muted" font-antialias="true" text-alignment="center" text-inset="0, 0" transparent="true" style-no-frame="true" mouse-enabled="false" wants-focus="false" />
